#!/bin/bash
SESSION="dev"
EXISTS=$(tmux ls 2>/dev/null | grep $SESSION)

KB_DIR=~/workspace/KnowledgeBase/

if [[ -z "$EXISTS" ]]; then
  tmux new-session -d -s $SESSION

  if [[ -d "$KB_DIR" ]]; then
    tmux rename-window -t 0 'kb'
    tmux send-keys -t 'kb' "cd '$KB_DIR'" C-m 'clear' C-m
    tmux split-window -h -l 15 -t $SESSION:0 -c "$KB_DIR"
  fi

# Use explicit -c paths: #{pane_current_path} targets the wrong pane/context, and cd via
# send-keys may not have updated the source_pane's path before split-window runs.
# Example:
# tmux new-window -t $SESSION -n 'lib'
# tmux send-keys -t 'lib' 'cd ~/workspace/BFG.Portal.Mobile.Shared.Library/' C-m 'clear' C-m
# tmux split-window -t 'lib' -h -l 15 -c "$HOME/workspace/BFG.Portal.Mobile.Shared.Library"

{{ if eq .machine "Shine" -}}
  # Shine Workspaces
{{ else -}}
  tmux new-window -t $SESSION -n 'code'
  tmux send-keys -t 'code' 'cd ~/workspace/' C-m 'clear' C-m
  tmux split-window -t 'code' -h -l 15 -c "$HOME/workspace"
{{ end -}}

  # General purpose shell window
  tmux new-window -t $SESSION -n 'shell'
fi

tmux attach-session -t $SESSION:0
